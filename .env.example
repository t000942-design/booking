# Copy to `.env.local` for development; on Vercel, set these in
# Project Settings → Environment Variables.

# ----- App ---------------------------------------------------
APP_NAME="Kick Off"

# Public URL of the deployed site. On Vercel, leave this blank and the
# code uses VERCEL_URL automatically. Set it in dev (e.g. http://localhost:3000)
# or to a custom domain in prod.
APP_URL=""

# ----- Storage (Supabase) ------------------------------------
# Without these, the app falls back to an in-memory store. That's fine
# for a demo deploy but bookings reset on every cold start.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# ----- Payments (MyFatoorah) ---------------------------------
# Without these, payment is stubbed (no real charge). The "Pay" button
# round-trips through the gateway-callback page and marks the booking PAID.
MYFATOORAH_BASE_URL="https://apitest.myfatoorah.com"
MYFATOORAH_API_TOKEN=""

# ----- AI Assistant (OpenRouter) -----------------------------
# Without OPENROUTER_API_KEY, the chatbot falls back to its rule-based
# replies. Get a key at https://openrouter.ai/keys (it should start with
# "sk-or-v1-...").
#
# Default model is the free tier of openai/gpt-oss-120b — works without
# topping up credits. For better quality, switch to a paid model
# (e.g. anthropic/claude-haiku-4.5) after adding credit at
# https://openrouter.ai/settings/credits.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-oss-120b:free"
