# Copy to `.env.local` for development; on Vercel, set these in
# Project Settings → Environment Variables.

# ----- App ---------------------------------------------------
APP_NAME="Kick Off"

# Public URL of the deployed site. On Vercel, leave this blank and the
# code uses VERCEL_URL automatically. Set it in dev (e.g. http://localhost:3000)
# or to a custom domain in prod.
APP_URL=""

# ----- Storage + Edge Functions (Supabase) -------------------
# Without these, the app falls back to an in-memory store and a stubbed
# payment flow. Bookings reset on every cold start in that mode.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
# Anon key is used to call Edge Functions from the Next.js side.
SUPABASE_ANON_KEY=""

# ----- Payments (MyFatoorah) ---------------------------------
# Two ways to wire this in (set ONE — direct beats edge):
#
# A. Direct (simpler, for testing). Drop the token here and Next.js calls
#    MyFatoorah directly. Test cards: https://docs.myfatoorah.com/docs/test-cards
MYFATOORAH_API_TOKEN=""
MYFATOORAH_BASE_URL="https://apitest.myfatoorah.com"
# Optional: webhook secret for verifying MyFatoorah → /api/webhooks/myfatoorah
# requests. Get it from the MyFatoorah Portal → Settings → Webhook.
# When unset, the endpoint accepts any POST (only do this in test).
MYFATOORAH_WEBHOOK_SECRET=""
#
# B. Via Supabase Edge Function (token never reaches Vercel). Leave
#    MYFATOORAH_API_TOKEN empty above; the code routes through the
#    `myfatoorah` edge function instead. Deploy:
#      supabase functions deploy myfatoorah --no-verify-jwt
#      supabase secrets set MYFATOORAH_API_TOKEN=<token>
#      supabase secrets set MYFATOORAH_BASE_URL=https://apitest.myfatoorah.com
#
# With neither configured the app stubs the payment (instant success).

# ----- AI Assistant (OpenRouter) -----------------------------
# Without OPENROUTER_API_KEY, the chatbot falls back to its rule-based
# replies. Get a key at https://openrouter.ai/keys (it should start with
# "sk-or-v1-...").
#
# Default model is the free tier of openai/gpt-oss-120b — works without
# topping up credits. For better quality, switch to a paid model
# (e.g. anthropic/claude-haiku-4.5) after adding credit at
# https://openrouter.ai/settings/credits.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-oss-120b:free"
